# Google Gemini API Key (Server-side only — NEVER prefix with NEXT_PUBLIC_)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Backend URL (defaults to http://127.0.0.1:8000 when running full stack)
# For standalone Vercel deployment, the Next.js API routes run serverlessly
NEXT_PUBLIC_BACKEND_URL=
